 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 61, "seek": 19300, "start": 203.0, "end": 205.0, "text": " Cain knew his wife", "tokens": [50863, 28370, 2993, 465, 3656, 50963], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 62, "seek": 19300, "start": 205.0, "end": 207.0, "text": " She couldn't see", "tokens": [50963, 1375, 3521, 470, 766, 51063], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 63, "seek": 19300, "start": 207.0, "end": 209.0, "text": " And bore Enoch", "tokens": [51063, 843, 18631, 2039, 5374, 51163], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 64, "seek": 19300, "start": 209.0, "end": 211.0, "text": " He built a city and named it for his son Enoch", "tokens": [51163, 679, 3170, 257, 1748, 290, 3706, 340, 329, 465, 3367, 2039, 5374, 51263], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 65, "seek": 19300, "start": 211.0, "end": 213.0, "text": " To Enoch", "tokens": [51263, 1675, 2039, 5374, 51363], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 66, "seek": 19300, "start": 213.0, "end": 215.0, "text": " Was born gay-died", "tokens": [51363, 8920, 4642, 5650, 12, 67, 798, 51463], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 67, "seek": 19300, "start": 215.0, "end": 216.0, "text": " Gay-died", "tokens": [51463, 16013, 12, 67, 798, 51513], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 68, "seek": 19300, "start": 216.0, "end": 217.0, "text": " Father Malaleo", "tokens": [51513, 9190, 4434, 1000, 78, 51563], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 69, "seek": 19300, "start": 217.0, "end": 218.0, "text": " Malaleo", "tokens": [51563, 4434, 1000, 78, 51613], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 70, "seek": 19300, "start": 218.0, "end": 219.0, "text": " Father Nathusala", "tokens": [51613, 9190, 399, 776, 385, 6081, 51663], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 71, "seek": 19300, "start": 219.0, "end": 220.0, "text": " And Matusala", "tokens": [51663, 843, 6550, 385, 6081, 51713], "temperature": 0.0, "avg_logprob": -0.25213113161596923, "compression_ratio": 1.5197740112994351, "no_speech_prob": 0.10420709103345871}, {"id": 72, "seek": 22000, "start": 220.0, "end": 221.0, "text": " Father Lometch", "tokens": [50363, 9190, 406, 296, 316, 354, 50413], "temperature": 0.0, "avg_logprob": -0.3728552837761081, "compression_ratio": 1.6752136752136753, "no_speech_prob": 0.3623702824115753}, {"id": 73, "seek": 22000, "start": 221.0, "end": 222.0, "text": " Lometch", "tokens": [50413, 406, 296, 316, 354, 50463], "temperature": 0.0, "avg_logprob": -0.3728552837761081, "compression_ratio": 1.6752136752136753, "no_speech_prob": 0.3623702824115753}, {"id": 74, "seek": 22000, "start": 222.0, "end": 223.0, "text": " Lometch took two wives", "tokens": [50463, 406, 296, 316, 354, 1718, 734, 17743, 50513], "temperature": 0.0, "avg_logprob": -0.3728552837761081, "compression_ratio": 1.6752136752136753, "no_speech_prob": 0.3623702824115753}, {"id": 75, "seek": 22000, "start": 223.0, "end": 224.0, "text": " One was named out of",